{
  "functions": {
    "api/generate-lyrics.js": { "maxDuration": 60 },
    "api/generate-lyrics-v5.js": { "maxDuration": 60 },
    "api/ai-status.js": { "maxDuration": 20 },
    "api/stem-config.js": { "maxDuration": 30 },
    "api/stem-upload.js": { "maxDuration": 60 },
    "api/stem-start.js": { "maxDuration": 60 },
    "api/stem-status.js": { "maxDuration": 60 },
    "api/stem-cancel.js": { "maxDuration": 60 },
    "api/stem-cleanup.js": { "maxDuration": 60 },
    "api/remote.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
